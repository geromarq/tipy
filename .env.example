# ============================================
# TIPY — Variables de entorno
# Copiá este archivo como .env.local y completá
# ============================================

# Supabase — el ANON KEY es safe para exponer, controla acceso via RLS
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVICE ROLE KEY — NUNCA expongas con prefijo NEXT_PUBLIC_
# Usado solo en API routes del servidor
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App URL
NEXT_PUBLIC_APP_URL=https://tipy.uy

# MercadoPago — NUNCA expongas estas claves al cliente
# El access token del DUEÑO DE LA APP (para webhooks globales si es necesario)
# Los tokens individuales de cada DJ se guardan cifrados en la DB
MP_WEBHOOK_SECRET=tu_webhook_secret_de_mp_panel

# Cifrado AES-256 para los access tokens de MercadoPago de los DJs
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=tu_clave_hex_de_32_bytes

# Music APIs — NUNCA expongas al cliente
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

LASTFM_API_KEY=

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hola@tipy.uy

# Security
# Generar con: openssl rand -hex 24
INTERNAL_SECRET=tu_secreto_interno_para_routes
